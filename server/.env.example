# Firebase Admin SDK Configuration
# Generated from service account JSON file
# DO NOT commit this file to version control

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40your-project-id.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Server Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Web API key used only for Firebase Authentication REST operations
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FRONTEND_URL=http://localhost:5173

# Mandatory anti-spoof veto. Scores at or above this value are always rejected.
ANTISPOOF_REJECT_THRESHOLD=0.5
ANTISPOOF_SERVICE_URL=http://localhost:8001/antispoof
ANTISPOOF_SERVICE_TIMEOUT_MS=15000

# Production must reject placeholder/heuristic anti-spoof services.
# Keep false only for local prototype development.
REQUIRE_PRODUCTION_ANTISPOOF=false

EMBED_SERVICE_URL=http://localhost:8000/embed
EMBED_SERVICE_TIMEOUT_MS=15000
HEALTH_CHECK_TIMEOUT_MS=3000

# Required: high-entropy secret used for AES-256-GCM envelope encryption.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never rotate this value without first re-wrapping stored data keys.
VOICEPRINT_MASTER_KEY=replace-with-at-least-32-random-characters

# Recommended rotation format. The active version is used for new data while
# older versions remain available for decrypting and re-wrapping existing keys.
# VOICEPRINT_MASTER_KEYS={"1":"old-32+-character-secret","2":"new-32+-character-secret"}
# VOICEPRINT_ACTIVE_KEY_VERSION=2

# Separate HMAC key protects audit records from undetected edits.
AUDIT_HMAC_KEY=replace-with-a-different-32-character-random-secret
# AUDIT_HMAC_KEYS={"1":"old-audit-secret-32+-characters","2":"new-audit-secret-32+-characters"}
# AUDIT_ACTIVE_KEY_VERSION=2

# Abuse protection. Use a shared rate-limit store when running multiple API replicas.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
BIOMETRIC_RATE_LIMIT_WINDOW_MS=3600000
BIOMETRIC_RATE_LIMIT_MAX=10

# Upload/storage limits
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
LOCAL_ENCRYPTED_AUDIO_ROOT=./data/encrypted-audio

# Optional bootstrap administrators (comma-separated). Prefer assigning the
# Firebase custom claim through the protected admin API after initial setup.
ADMIN_EMAILS=admin@example.com
